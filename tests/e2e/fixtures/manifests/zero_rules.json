{
  "schema_version": "1",
  "pack_id": "cbe-core",
  "pack_version": "0.1.0",
  "description": "Full CBE manifest fixture",
  "package_types": [
    "cbs",
    "cbe"
  ],
  "providers": {
    "builtin-manifest": {
      "kind": "builtin",
      "output_formats": [
        "json"
      ]
    },
    "gitleaks": {
      "kind": "exec",
      "output_formats": [
        "sarif"
      ],
      "command": [
        "python",
        "tests/e2e/fixtures/providers/sarif_findings.py",
        "{out}/gitleaks.sarif"
      ],
      "timeout_seconds": 300
    }
  },
  "rules": []
}
