{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbe.cyberbutler.dev/schemas/v1.7/releases.schema.json",
  "title": "CBE release snapshot for F4 baseline selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "releases"],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "version",
        "prerelease",
        "labels",
        "body",
        "commit",
        "gate_status",
        "published_at"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "prerelease": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "body": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "gate_status": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cbe": {
              "$ref": "#/$defs/gateStatus"
            },
            "cbp": {
              "$ref": "#/$defs/gateStatus"
            }
          }
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "gateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIPPED_INFRA",
        "PRECONDITION_FAIL",
        "EVIDENCE_ABSENT"
      ]
    }
  }
}
