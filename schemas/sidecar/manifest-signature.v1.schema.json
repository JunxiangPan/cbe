{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JunxiangPan/cbe/schemas/sidecar/manifest-signature.v1.schema.json",
  "title": "CBE manifest/report signature sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alg",
    "keyid",
    "subject",
    "manifest_sha256",
    "report_sha256",
    "attestation_sha256",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "alg": {"const": "ed25519"},
    "keyid": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
  }
}
