{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbe.cyberbutler.dev/schemas/provider-output.v1.schema.json",
  "title": "CBE provider JSON output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "tool", "results"],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "level", "message", "location"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^CBE-[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-[0-9]{3}$"
        },
        "provider_rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "level": {
          "enum": ["error", "warning", "note"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "start_line"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "start_column": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_column": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
