{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbe.cyberbutler.dev/schemas/rule-pack-manifest.v1.schema.json",
  "title": "CBE Rule Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "package_types",
    "providers",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "pack_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "package_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["cbs", "cbe", "cbp", "cbm", "cbc", "cbg", "cbf"]
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "output_formats"],
      "properties": {
        "kind": {
          "enum": ["builtin", "exec"]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "output_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["sarif", "json"]
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "exec"
              }
            }
          },
          "then": {
            "required": ["command"]
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "builtin"
              }
            }
          },
          "then": {
            "not": {
              "required": ["command"]
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "severity",
        "gate",
        "provider",
        "version_constraint",
        "package_types"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^CBE-[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-[0-9]{3}$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "enum": ["error", "warning", "note"]
        },
        "gate": {
          "enum": ["blocking", "advisory"]
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version_constraint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(\\*|(>=|>|<=|<|=)[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?( (>=|>|<=|<|=)[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?)*)$"
        },
        "package_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["cbs", "cbe", "cbp", "cbm", "cbc", "cbg", "cbf"]
          }
        },
        "provider_rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          }
        },
        "sarif": {
          "$ref": "#/$defs/sarif"
        }
      }
    },
    "sarif": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "short_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "full_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "help_uri": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    }
  }
}
