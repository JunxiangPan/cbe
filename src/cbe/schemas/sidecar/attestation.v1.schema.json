{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JunxiangPan/cbe/schemas/sidecar/attestation.v1.schema.json",
  "title": "CBE in-toto-compatible release attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        }
      }
    },
    "predicateType": {"const": "https://github.com/JunxiangPan/cbe/attestation/release/v1"},
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "gate_status", "exit_code"],
      "properties": {
        "schema_version": {"const": "1"},
        "gate_status": {"enum": ["PASS", "FAIL", "SKIPPED_INFRA", "PRECONDITION_FAIL", "NOT_UPLOADED"]},
        "exit_code": {"enum": [0, 2, 3, 4]},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
